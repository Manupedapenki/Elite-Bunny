# GitHub App Configuration
GITHUB_APP_ID=your_app_id
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem

# LLM Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxx
DEFAULT_MODEL=claude-sonnet-4-6

# Infrastructure (defaults for Docker Compose)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DATABASE_URL=postgresql+asyncpg://pi_user:pi_local_password@localhost:5432/pr_intelligence
REDIS_URL=redis://localhost:6379/0

# Application Settings
CONFIDENCE_THRESHOLD=0.6
MAX_DIFF_SIZE_BYTES=500000
MAX_FILES_PER_ANALYSIS=30
LOG_LEVEL=INFO
